# Contenuti scaricati (pesanti + copyright): mai su GitHub
download_audio/
failed_tracks.txt

# Database locale (condiviso con gli altri scraper)
*.db
*.db-shm
*.db-wal
*.db.backup-*

# Preferenze locali (lingua dell'interfaccia): sono di chi usa il programma,
