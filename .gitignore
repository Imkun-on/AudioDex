settings.json

# Log
logs/
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# IDE / sistema
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
*.lnk
~$*

# Catture dello schermo lasciate nella cartella.
#
# Il pattern e' quello del nome che ci mette Windows, con la data: "Screenshot
# 2026-08-02 205040.png". NON e' "Screenshot*", che qui sarebbe una trappola:
# su Windows git confronta i nomi senza distinguere maiuscole e minuscole
# (core.ignorecase), quindi "Screenshot*" prenderebbe anche screenshot.png, che
# invece deve restare versionato perche' e' l'immagine dei README.
Screenshot 20*.png
Screenshot_20*.png

# Appunti di lavoro locali
memory/

# Sfondo della GUI: scaricato al primo avvio dalla Release, non versionato
assets/*.mp4

# Costruzione dell'eseguibile: il .exe pesa 40 MB e si rifa' in due minuti
# da AudioDex.spec, quindi nel repository non ha senso tenerlo. Sta come
# allegato della Release, ed e' li' che va cercato.
build/
dist/
# Anche fuori da dist/: un eseguibile copiato sul desktop del progetto per
# provarlo, e committato per distrazione, sono 40 MB dentro la storia di git
# che poi non si tolgono piu' senza riscriverla.
*.exe
*.pyz
*.spec.bak

# Cartelle di lavoro e roba di passaggio
tmp/
temp/
.pytest_cache/
*.tmp
*.bak
*.orig
